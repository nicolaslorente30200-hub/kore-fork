<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/background_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0.2"
            android:contentDescription="@string/fanart"/>

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/default_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.Kore.Toolbar" />

        <LinearLayout
            android:id="@+id/pager_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/default_toolbar">

            <org.xbmc.kore.ui.widgets.HighlightButton
                android:id="@+id/nav_now_playing"
                style="@style/Widget.Kore.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="@dimen/buttonbar_height"
                android:layout_weight="1"
                android:contentDescription="@string/now_playing"
                android:src="@drawable/ic_round_play_arrow_24" />

            <org.xbmc.kore.ui.widgets.HighlightButton
                android:id="@+id/nav_remote"
                style="@style/Widget.Kore.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="@dimen/buttonbar_height"
                android:layout_weight="1"
                android:contentDescription="@string/remote"
                android:src="@drawable/ic_round_gamepad_24" />

            <org.xbmc.kore.ui.widgets.HighlightButton
                android:id="@+id/nav_playlist"
                style="@style/Widget.Kore.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="@dimen/buttonbar_height"
                android:layout_weight="1"
                android:contentDescription="@string/playlist"
                android:src="@drawable/ic_round_queue_24" />

        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:id="@+id/pager"
            app:layout_constraintTop_toBottomOf="@id/pager_tabs"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.fragment.app.FragmentContainerView android:id="@+id/navigation_drawer"
              android:layout_width="@dimen/navigation_drawer_width"
              android:layout_height="match_parent"
              android:layout_gravity="start"
              android:name="org.xbmc.kore.ui.generic.NavigationDrawerFragment"/>

</androidx.drawerlayout.widget.DrawerLayout>
